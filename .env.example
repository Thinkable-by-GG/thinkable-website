# WordPress origin used by the sync scripts and the dev-server form proxy.
WP_URL=https://thinkable.app
VITE_WP_URL=https://thinkable.app

# WordPress admin login for scripts/wp/*. Leave unset to read
# ~/dev/creds/thinkable-app-wordpress.md (or set WP_CREDS_FILE to another path).
# WP_USER=
# WP_PASS=
