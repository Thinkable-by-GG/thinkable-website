{
  "name": "thinkable-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Source of truth for thinkable.app: WordPress theme + content mirror, sync scripts, and the React rebuild of the partner-facing site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "wp:pull": "node scripts/wp/pull.mjs",
    "wp:push:theme": "node scripts/wp/push-theme.mjs",
    "wp:push:content": "node scripts/wp/push-content.mjs",
    "wp:diff": "node scripts/wp/push-theme.mjs --all --dry-run",
    "styles:build": "node scripts/wp/build-styles.mjs",
    "predev": "npm run styles:build",
    "prebuild": "npm run styles:build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
